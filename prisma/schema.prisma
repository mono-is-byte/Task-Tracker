generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---------- Auth / users ----------
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  username           String    @unique
  name               String
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  active             Boolean   @default(true)
  /// Change request Phase 4: soft delete marker. Deleted users cannot log in,
  /// are unassigned from tasks and removed from project memberships, but their
  /// comments/activity history stays.
  deletedAt          DateTime?
  isSuperAdmin       Boolean   @default(false)
  lockedUntil        DateTime?
  failedLogins       Int       @default(0)
  theme              String    @default("system")
  avatarUrl          String?
  /// Change request: designation = a REFERENCE to a role (Roles & Permissions).
  /// The stored value is the Role id; every display resolves the role's current
  /// name live, so renaming a role updates every user's designation at once.
  designation        String?
  /// Change request Phase 2: optional gender. Free column on purpose (SQLite +
  /// zod validation keeps the four allowed options: Male / Female / Other /
  /// Prefer not to say) so the value can be extended without a migration.
  gender             String?
  hoursPerDay        Float?
  lastActiveAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships    ProjectMember[]
  assignedTasks  Task[]            @relation("TaskAssignee")
  testedTasks    Task[]            @relation("TaskTester")
  /** PHASE 4: tasks this user ASSIGNED to someone (the "assigned by" side). */
  assignedByTasks Task[]           @relation("TaskAssigner")
  sessions       Session[]
  auditLogs      AuditLog[]        @relation("AuditActor")
  comments       Comment[]
  activities     Activity[]
  notifications  Notification[]
  savedViews     SavedView[]
  resets         PasswordReset[]
  avatarFile     UserAvatar?
}

/// Serverless avatar storage: on hosts with a read-only filesystem (e.g. Vercel)
/// the uploaded JPEG lives here instead of public/uploads/. Local/self-hosted
/// installs keep writing files to disk and never fill this table.
model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mimeType  String
  bytes     Bytes
  updatedAt DateTime @updatedAt
}

model Session {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  idleExpiresAt DateTime
  rememberMe   Boolean   @default(false)
  revokedAt    DateTime?
  ip           String?
  userAgent    String?

  @@index([userId])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  ip         String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  meta      String   @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

// ---------- Roles & permissions ----------
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String   @default("{}")
  fieldRules  String   @default("{}")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberLinks ProjectMemberRole[]
  statusDesignationTags StatusDesignationTag[]
}

/// Phase 1 (role = designation): a status can SUGGEST the project roles that
/// usually work in it. Stored as role ids (never copied text), so renaming a
/// role updates every suggestion and deleting a role removes its suggestions.
model StatusDesignationTag {
  id        String   @id @default(cuid())
  statusId  String
  status    Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([statusId, roleId])
  @@index([roleId])
}

// ---------- Projects ----------
model Project {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  hoursPerDay Float    @default(8)
  workingDays String   @default("[1,2,3,4,5]")
  bannerNote  String?
  settings    String   @default("{}")
  /// Phase 3: hidden projects are excluded from default project lists
  /// (home, sidebar); members with the link can still open them.
  isHidden    Boolean  @default(false)
  /// Change request Phase 2: set automatically when the project has >= 1 task and
  /// every task sits in a final (category "done") status. Drives the sidebar's
  /// Completed Projects section. 0 tasks never counts as completed.
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        ProjectMember[]
  statuses       Status[]
  transitions    StatusTransition[]
  priorities     Priority[]
  issueTypes     IssueType[]
  epics          Epic[]
  tasks          Task[]
  customFields   CustomField[]
  automationRules AutomationRule[]
  savedViews     SavedView[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  roles ProjectMemberRole[]

  @@unique([projectId, userId])
  @@index([userId])
}

/// Join table: a project member can hold MULTIPLE roles. Effective permissions are the
/// union of all assigned roles. Replaces the old single `ProjectMember.roleId`.
model ProjectMemberRole {
  id        String        @id @default(cuid())
  memberId  String
  member    ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([memberId, roleId])
  @@index([roleId])
}

model Status {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  category  String  @default("todo")
  color     String  @default("#94a3b8")
  position  Int     @default(0)
  // Change request (round 2): how this column treats the task timer.
  // NONE = no timer UI at all (initial "To Do", "Re-open"), TRACK = manual
  // Start/Stop buttons (running work), FINAL = Done (total time, read-only).
  timerRole String  @default("TRACK")

  tasks       Task[]
  fromLinks   StatusTransition[] @relation("TransFrom")
  toLinks     StatusTransition[] @relation("TransTo")
  designationTags StatusDesignationTag[]
  stageTimes  TaskStageTime[]

  @@unique([projectId, name])
}

model StatusTransition {
  id           String  @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromId       String
  from         Status  @relation("TransFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId         String
  to           Status  @relation("TransTo", fields: [toId], references: [id], onDelete: Cascade)
  roleIds      String  @default("[]")
  issueTypeIds String  @default("[]")

  @@unique([projectId, fromId, toId])
}

model Priority {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  level     Int     @default(3)
  color     String  @default("#94a3b8")

  tasks Task[]

  @@unique([projectId, name])
}

model IssueType {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String  @default("#6366f1")

  tasks Task[]

  @@unique([projectId, name])
}

model Epic {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String   @default("#8b5cf6")
  status      String   @default("open")
  position    Int      @default(0)

  tasks   Task[]
}

model Task {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serial        Int
  typeId        String?
  type          IssueType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  epicId        String?
  epic          Epic?     @relation(fields: [epicId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  estHours      Float?
  rdTime        Float     @default(0)
  loggedHours   Float     @default(0)
  priorityId    String
  priority      Priority  @relation(fields: [priorityId], references: [id])
  statusId      String
  status        Status    @relation(fields: [statusId], references: [id])
  assigneeId    String?
  assignee      User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// PHASE 4 — "assigned by" tracking. `assignedById`/`assignedAt` are SYSTEM
  /// fields the server derives from the authenticated session (never accepted
  /// from the client). They mirror the LATEST assignment; the full history
  /// (reassign/unassign) lives in `Activity` rows with action "task.assigned".
  assignedById  String?
  assignedBy    User?     @relation("TaskAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt    DateTime?
  testedById    String?
  testedBy      User?     @relation("TaskTester", fields: [testedById], references: [id], onDelete: SetNull)
  startDate     DateTime?
  endDate       DateTime?
  dueAt         DateTime?
  startedAt     DateTime?
  stoppedAt     DateTime?
  overdueNotifiedAt DateTime?
  // Cumulative timer state: startedAt (first Start click, never reset),
  // stageEnteredAt (the open Stop-able segment), totalSeconds (closed segments)
  // + TaskStageTime rows as the per-stage history.
  totalSeconds  Int       @default(0)
  stageEnteredAt DateTime?
  gitBranch     String?
  labels        String    @default("[]")
  customValues  String    @default("{}")
  position      Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  linksFrom  TaskLink[]  @relation("LinkFrom")
  linksTo    TaskLink[]  @relation("LinkTo")
  comments   Comment[]
  activities Activity[]
  stageTimes TaskStageTime[]

  @@unique([projectId, serial])
  @@index([projectId, statusId])
  @@index([projectId, assigneeId])
  // PHASE 4: the Table's "Assigned by" filter queries this pair.
  @@index([projectId, assignedById])
}

/** Change request: one row per Start→Stop segment (stage history). */
model TaskStageTime {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  statusId  String
  status    Status    @relation(fields: [statusId], references: [id], onDelete: Cascade)
  enteredAt DateTime
  leftAt    DateTime?
  seconds   Int       @default(0)

  @@index([taskId])
}

model TaskLink {
  id     String @id @default(cuid())
  fromId String
  from   Task   @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Task   @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)
  kind   String @default("blocks")

  @@unique([fromId, toId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind      String   @default("comment")
  body      String
  /// Optional "solved" marker for comments/remarks/feedback. Null = still open.
  /// Editing a note clears it (the UI then offers the Solve button again).
  solvedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model Activity {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  field     String?
  before    String?
  after     String?
  /// PHASE 4: small JSON extra for an event (e.g. `{"via":"automation:Rule name"}`
  /// on "task.assigned" rows). Nullable — older rows have no meta.
  meta      String?
  createdAt DateTime @default(now())

  @@index([taskId])
}

model CustomField {
  id             String  @id @default(cuid())
  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  fieldType      String  @default("text")
  options        String  @default("[]")
  required       Boolean @default(false)
  showIn         String  @default("[\"table\",\"card\",\"form\"]")
  roleVisibility String  @default("{}")
  position       Int     @default(0)

  @@unique([projectId, name])
}

model AutomationRule {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  trigger   String
  condition String  @default("{}")
  action    String  @default("{}")
  enabled   Boolean @default(true)
  position  Int     @default(0)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model SavedView {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String   @default("table")
  name      String
  config    String   @default("{}")
  createdAt DateTime @default(now())
}

/** Holidays are global for everyone - no per-project scope (item 1).
 *  A holiday covers [date .. endDate] inclusive; `endDate` null or equal to
 *  `date` means a single day. `type` is a free label (public/festival/office/other).
 *  Working-day exceptions never touch these rows. */
model Holiday {
  id          String    @id @default(cuid())
  date        DateTime
  endDate     DateTime?
  name        String    @default("")
  description String    @default("")
  type        String    @default("public")
}

/** Working-day exception: the office stays open on a weekly holiday (Fri/Sat)
 *  or on a configured holiday. Precedence: exception > holiday/ weekly holiday.
 *  Removing the exception restores the underlying holiday status because the
 *  Holiday row is never changed by this table. */
model WorkingDayException {
  id        String   @id @default(cuid())
  date      DateTime @unique
  note      String   @default("")
  createdAt DateTime @default(now())
}
