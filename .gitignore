# Dependencies
node_modules/

# Next.js build output
.next/
out/

# TypeScript incremental build info
*.tsbuildinfo

# Next.js generated type declarations (managed by Next.js — do not commit)
next-env.d.ts

# Local SQLite databases and their journals
*.db
*.db-journal
*.db-wal
*.db-shm

# Environment files (the template is committed on purpose)
.env*
!.env.example

# Local safety snapshots (Phase 0 pre-refactor backup)
backup/

# Test coverage
coverage/

# User-uploaded files
public/uploads/

# Vercel CLI project link (created per machine by `vercel link`)
.vercel