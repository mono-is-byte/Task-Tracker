# never commit real secrets — copy to .env and fill in
# Local development / self-hosting: SQLite file
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"

# Serverless hosting (e.g. Vercel) — read-only filesystem, so point the app at a
# remote libSQL/Turso database instead of a local file. When set, these take
# precedence over DATABASE_URL for the running app.
# TURSO_DATABASE_URL="libsql://<database>-<org>.turso.io"
# TURSO_AUTH_TOKEN="<token from `turso db tokens create <database>`>"

# optional mail for reset links (if unset, password resets are admin-triggered)
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# SMTP_FROM="tasktracker@example.com"
